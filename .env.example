# =============================================================================
# BountyFlow configuration. Copy to `.env` and adjust. NEVER commit `.env`.
# Values marked REPLACE are placeholders and are rejected in production.
# Server-only settings here are never exposed to the frontend bundle.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
APP_NAME=BountyFlow
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=false                      # true = single-line JSON logs (Logifyx JSON mode) for log aggregators
LOG_OUTPUT=console                  # console | file | both | none (Logifyx output mode)

# --- Startup automation ---------------------------------------------------
# Apply Alembic migrations when the API starts (safe with several replicas: guarded by a Postgres advisory lock).
RUN_MIGRATIONS_ON_STARTUP=true
# Run the idempotent seed on every API start: existing records are kept, only missing data is inserted.
# Refused automatically when APP_ENV is staging/production.
SEED_ON_STARTUP=true
MAX_REQUEST_BODY_BYTES=1048576
# Number of reverse proxies in front of the API that append to X-Forwarded-For (the bundled nginx = 1).
# Use 0 when the API is exposed directly, so client-supplied X-Forwarded-For is never trusted for rate limits.
TRUSTED_PROXY_HOPS=1

# --- PostgreSQL (source of truth) ------------------------------------------
POSTGRES_USER=bountyflow
POSTGRES_PASSWORD=bountyflow-local-dev-password
POSTGRES_DB=bountyflow
# Host-run API uses localhost; inside Docker Compose this is overridden to the `postgres` service.
DATABASE_URL=postgresql+psycopg://bountyflow:bountyflow-local-dev-password@localhost:5432/bountyflow
# Used by `make test-api` — an isolated database created by infra/postgres/init.
TEST_DATABASE_URL=postgresql+psycopg://bountyflow:bountyflow-local-dev-password@localhost:5432/bountyflow_test

# --- Redis (cache, rate limits, challenges, locks) -----------------------------
REDIS_URL=redis://localhost:6379/0

# --- Kafka (domain events via transactional outbox) ------------------------
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CONSUMER_GROUP=bountyflow-workers
KAFKA_TOPIC_PREFIX=

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE-with-a-long-random-secret-dev-only
ACCESS_TOKEN_TTL=900                # seconds
REFRESH_TOKEN_TTL=2592000           # seconds (30 days)
COOKIE_SECURE=false                 # MUST be true in production (HTTPS)
COOKIE_SAMESITE=lax
# Password for the accounts created by the development seed (`make seed` prints their emails).
SEED_USER_PASSWORD=BountyFlow!2026

# --- Email (Mailpit captures mail locally at http://localhost:8025) ----------
EMAIL_BACKEND=smtp                  # smtp | console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=BountyFlow <no-reply@bountyflow.local>

# --- Stellar / Soroban -----------------------------------------------------
# testnet = Stellar Testnet (default) · mainnet = reserved for a separate, audited production deployment
BLOCKCHAIN_MODE=testnet
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet
# The deployed BountyFlow escrow on Testnet (public values; see contracts/deployments/testnet.json).
# `make contract-deploy-testnet` deploys your own and prints new values.
SOROBAN_CONTRACT_ID=CDX6FN2MIGLHCMUJOU6C7FYP3QTNDL6BVIPEG4B5HAUEPU7NI4SFY4CY
# Stellar Asset Contract for native XLM on testnet (`stellar contract id asset --asset native --network testnet`)
STELLAR_NATIVE_ASSET_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Public key of the dispute arbiter wallet (a moderator-controlled wallet). Public value, not a secret.
STELLAR_ARBITER_ADDRESS=GDKMJJGPM7ZFTDG6Y74O6JA2QCMQBEJJE7Q7I5FGKI77Z67XXY2C3LU2
BLOCKCHAIN_CONFIRMATION_TIMEOUT=120
# Server key used ONLY to sign wallet-ownership challenges (never holds funds, never submitted).
# Generate: python -c "from stellar_sdk import Keypair; print(Keypair.random().secret)"
# If empty in development, a key is derived from JWT_SECRET.
WALLET_CHALLENGE_SIGNING_SECRET=
WALLET_CHALLENGE_HOME_DOMAIN=bountyflow.local

# --- Frontend (public, build-time; never put secrets in VITE_ variables) -----
VITE_API_BASE_URL=/api/v1
