            "repos_url": "https://api.github.com/users/SocketDev/repos",
            "events_url": "https://api.github.com/users/SocketDev/events{/privacy}",
            "received_events_url": "https://api.github.com/users/SocketDev/received_events",
            "type": "Organization",
