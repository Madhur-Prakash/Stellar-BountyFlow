# BountyFlow frontend environment. Everything prefixed VITE_ is PUBLIC and is
# embedded in the browser bundle: never put secrets here.

# Base URL of the versioned REST API as seen by the browser.
# Default: /api/v1 (same origin; proxied by Vite in dev and by nginx in Docker).
VITE_API_BASE_URL=/api/v1

# Dev-server only: where Vite proxies /api and /health (not bundled).
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional: public source repository URL (https only) shown in the footer.
VITE_GITHUB_URL=

# E2E ONLY (never in production): enables the Playwright-injected test wallet
# provider so end-to-end tests can sign real Testnet transactions without the
# Freighter extension. `vite build` in production mode fails if this is set.
# VITE_ENABLE_TEST_WALLET=true
