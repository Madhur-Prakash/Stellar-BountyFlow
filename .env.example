# =============================================================================
# BountyFlow configuration. Copy to `.env` and adjust. NEVER commit `.env`.
# Values marked REPLACE are placeholders and are rejected in production.
# Server-only settings here are never exposed to the frontend bundle.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
APP_NAME=BountyFlow
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Host ports the Docker stack publishes on. The frontend matches FRONTEND_URL above, so the links in
# verification and notification emails resolve whether the app is served by Docker or by `pnpm dev`.
FRONTEND_HOST_PORT=5173
API_HOST_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false                      # true = single-line JSON logs (Logifyx JSON mode) for log aggregators
LOG_OUTPUT=console                  # console | file | both | none (Logifyx output mode)

# --- Startup automation ---------------------------------------------------
# Apply Alembic migrations when the API starts (safe with several replicas: guarded by a Postgres advisory lock).
RUN_MIGRATIONS_ON_STARTUP=true
# Run the idempotent seed on every API start: existing records are kept, only missing data is inserted.
# Refused automatically when APP_ENV is staging/production.
SEED_ON_STARTUP=true
MAX_REQUEST_BODY_BYTES=1048576
# Number of reverse proxies in front of the API that append to X-Forwarded-For (the bundled nginx = 1).
# Use 0 when the API is exposed directly, so client-supplied X-Forwarded-For is never trusted for rate limits.
TRUSTED_PROXY_HOPS=1

# --- PostgreSQL (source of truth) ------------------------------------------
POSTGRES_USER=bountyflow
POSTGRES_PASSWORD=bountyflow-local-dev-password
POSTGRES_DB=bountyflow
# Host-run API uses localhost; inside Docker Compose this is overridden to the `postgres` service.
DATABASE_URL=postgresql+psycopg://bountyflow:bountyflow-local-dev-password@localhost:5432/bountyflow
# Used by `make test-api` — an isolated database created by infra/postgres/init.
TEST_DATABASE_URL=postgresql+psycopg://bountyflow:bountyflow-local-dev-password@localhost:5432/bountyflow_test

# --- Redis (cache, rate limits, challenges, locks) -----------------------------
REDIS_URL=redis://localhost:6379/0

# --- Kafka (domain events via transactional outbox) ------------------------
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CONSUMER_GROUP=bountyflow-workers
KAFKA_TOPIC_PREFIX=

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE-with-a-long-random-secret-dev-only
ACCESS_TOKEN_TTL=900                # seconds
REFRESH_TOKEN_TTL=2592000           # seconds (30 days)
COOKIE_SECURE=false                 # MUST be true in production (HTTPS)
COOKIE_SAMESITE=lax
# Password for the accounts created by the development seed (`make seed` prints their emails).
SEED_USER_PASSWORD=BountyFlow!2026

# --- Email (Mailpit captures mail locally at http://localhost:8025) ----------
# Transport: an explicit "console" always wins; otherwise Gmail is used as soon as GMAIL_CREDENTIALS_B64 is
# set, and SMTP (Mailpit in development) is the fallback.
EMAIL_BACKEND=smtp                  # smtp | console | gmail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=BountyFlow <no-reply@bountyflow.local>

# --- Gmail API (real email) ------------------------------------------------
# Setting these three is all it takes to send for real; nothing else needs changing.
#
#   1. Create an OAuth client ID of type "Desktop app" in a Google Cloud project with the Gmail API enabled
#      and download its JSON.
#   2. uv sync --group dev
#      uv run python scripts/mint_gmail_token.py path/to/credentials.json
#      Consent as the mailbox that should send, and paste the printed line below.
#
# The token carries the gmail.send scope only, so it cannot read the mailbox it sends from. It is a secret:
# keep it out of commits. While the OAuth consent screen is in "Testing" Google expires it after 7 days —
# publish the app to stop that. A send failing with invalid_grant means it needs minting again.
GMAIL_CREDENTIALS_B64=
# The mailbox that consented. Gmail sends from the authorised account regardless, so this carries the display
# name and catches a mismatch early.
GMAIL_SENDER=
EMAIL_FROM_NAME=BountyFlow

# --- Stellar / Soroban -----------------------------------------------------
# testnet = Stellar Testnet (default) · mainnet = reserved for a separate, audited production deployment
BLOCKCHAIN_MODE=testnet
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet
# The deployed BountyFlow escrow on Testnet (public values; see contracts/deployments/testnet.json).
# `make contract-deploy-testnet` deploys your own and prints new values.
SOROBAN_CONTRACT_ID=CBCXG46FJPYBPWYZ24BWFVNJ6G2ILFAXHX2COETDNXYE6C5IJWAZ3M4C
# Stellar Asset Contract for native XLM (`stellar contract id asset --asset native --network testnet`).
# Optional: it is derived from the network passphrase, and a value that is not this network's own SAC is
# refused at startup. Every other reward asset's contract is derived the same way (see docs/blockchain.md).
STELLAR_NATIVE_ASSET_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Public key of the dispute arbiter wallet (a moderator-controlled wallet). Public value, not a secret.
STELLAR_ARBITER_ADDRESS=GDKMJJGPM7ZFTDG6Y74O6JA2QCMQBEJJE7Q7I5FGKI77Z67XXY2C3LU2
# Escrow v2 (interface version 2: milestones, review-window claims, M-of-N arbiters, batch payouts, upgrade).
# New escrows go to SOROBAN_CONTRACT_ID; escrows created on the v1 contract (CDX6FN2M...4SFY4CY) stay on it.
SOROBAN_CONTRACT_VERSION=2
# M-of-N dispute arbiters: comma-separated public keys and the approvals a resolution needs. Public values.
# Empty = the single STELLAR_ARBITER_ADDRESS with a threshold of 1 (the v1 behaviour).
STELLAR_ARBITER_ADDRESSES=
STELLAR_ARBITER_THRESHOLD=1
# Review window (seconds) for work recorded on-chain: the default and the range a requester may choose.
# Lower the minimum only for end-to-end tests (60 is the Testnet contract's floor); staging and production refuse
# less than 86400.
ESCROW_DEFAULT_REVIEW_WINDOW_SECONDS=604800
ESCROW_MIN_REVIEW_WINDOW_SECONDS=86400
ESCROW_MAX_REVIEW_WINDOW_SECONDS=2592000
# End-to-end tests only (frontend/e2e/escrow-v2.journey.spec.ts): secret seeds of the 2nd and 3rd arbiter of
# STELLAR_ARBITER_ADDRESSES, which the moderator and admin test sessions sign votes with. Never used by the backend.
# Generate: stellar keys generate <name> --network testnet --fund && stellar keys show <name>
E2E_ARBITER_SECRETS=
BLOCKCHAIN_CONFIRMATION_TIMEOUT=120
# Server key used ONLY to sign wallet-ownership challenges (never holds funds, never submitted).
# Generate: python -c "from stellar_sdk import Keypair; print(Keypair.random().secret)"
# If empty in development, a key is derived from JWT_SECRET.
WALLET_CHALLENGE_SIGNING_SECRET=
WALLET_CHALLENGE_HOME_DOMAIN=bountyflow.local

# --- Wallets: smart wallets and fee sponsorship ------------------------------
# SEP-45 web authentication contract (contracts/web_auth): proves control of a contract account (C...), which is
# how passkey smart wallets link. Public value. Deploy your own:
#   stellar contract build --package web_auth
#   stellar contract deploy --wasm contracts/target/wasm32v1-none/release/web_auth.wasm --source-account <key>
WEB_AUTH_CONTRACT_ID=CB3GXQ2BW2AHSIWUITLVBKODKPUHIK5DLEPWIIWTKLTKLA6TE24PLSZX
# Smart-wallet WASM new passkey wallets are deployed from (passkey-kit v1.1; already uploaded on Testnet).
PASSKEY_WALLET_WASM_HASH=97ce047884106b1c6c3bb40b8973cc48db1c4dad95c9e20462bf2c701daa764e
# Platform fee sponsor: pays the network fee of eligible contributor transactions (fee bumps) and sources every
# smart-wallet transaction. Fee sponsorship AND passkey wallets are off when this is empty.
# Generate and fund: stellar keys generate bountyflow-sponsor && stellar keys show bountyflow-sponsor
#   then https://friendbot.stellar.org/?addr=$(stellar keys address bountyflow-sponsor)
STELLAR_SPONSOR_SECRET=
# Most the sponsor bids for one transaction, and the per-user daily caps (UTC day).
SPONSOR_MAX_FEE_STROOPS=5000000
SPONSOR_DAILY_TX_LIMIT=25
SPONSOR_DAILY_FEE_LIMIT_STROOPS=50000000
# Warn in the admin console below this balance (XLM), and stop sponsoring below the second.
SPONSOR_LOW_BALANCE_XLM=100
SPONSOR_MIN_BALANCE_XLM=5
# Contracts besides SOROBAN_CONTRACT_ID whose calls may be sponsored, and the contributor-side functions.
SPONSOR_ALLOWED_CONTRACTS=
SPONSOR_ALLOWED_FUNCTIONS=consent_cancel,raise_dispute,submit_work,claim
# Classic assets (CODE:ISSUER) whose trustlines may be sponsored.
SPONSOR_ALLOWED_ASSETS=USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# --- Reputation: on-chain attestations and verifiable credentials ----------
# Attestation registry (contracts/attestations; public value, see contracts/deployments/attestations-testnet.json).
# `powershell -File scripts/deploy-attestations.ps1` (or scripts/deploy-attestations.sh) deploys your own.
ATTESTATION_CONTRACT_ID=CBXJVFUQHWECJZQSEBAFGHXLHP72PCPUX7XES42KVEMVAMZ26D5CZ33N
# Platform attester key: signs attestations of payouts verified on-chain. Attestations are off when empty.
# The registry only accepts the attester it was deployed with, so deploy your own registry for a new key.
# Generate: python -c "from stellar_sdk import Keypair; print(Keypair.random().secret)" (then fund it with Friendbot)
STELLAR_ATTESTER_SECRET=
# Ed25519 key that signs W3C verifiable credentials (did:web issuer). Credentials are off when empty.
# Generate: python -c "from stellar_sdk import Keypair; print(Keypair.random().secret)"
CREDENTIAL_ISSUER_SECRET=
# did:web host, port included (default: the FRONTEND_URL host). The DID document is served at /.well-known/did.json.
CREDENTIAL_ISSUER_DOMAIN=

# --- Discovery: saved-search alerts and skill-graph recommendations ---------
# UTC hour saved-search digests go out: daily ones every day, weekly ones on Mondays.
DISCOVERY_DIGEST_HOUR_UTC=8
# How often the worker rebuilds the skill graph from bounties and profiles (seconds).
DISCOVERY_GRAPH_REFRESH_SECONDS=1800
# Enables POST /admin/discovery/digests/run (admins only), which sends pending digests immediately instead of
# waiting for the schedule. Leave false outside end-to-end tests: the route answers 404 while it is off.
DISCOVERY_DIGEST_TRIGGER_ENABLED=false

# --- Collaboration: GitHub account linking and pull request verification ----
# BountyFlow reads only public data from the GitHub REST API. Everything below is optional: without any of it,
# accounts are still proved with a public gist and pull requests are still verified, just at GitHub's
# unauthenticated rate limit (60 requests an hour per IP), with caching and backoff.
# A token raises that to 5,000/hour. A fine-grained personal access token with no repository permissions and no
# account access is enough. Create one at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
# Optional "Connect with GitHub" (an OAuth app). Gist verification needs neither of these.
# Create one at https://github.com/settings/developers with the callback
# <FRONTEND_URL>/app/settings/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional webhook that re-checks a pull request as soon as it changes. The endpoint is POST /api/v1/github/webhook
# and answers 404 while this is empty. Use the same value as the webhook's secret on GitHub.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
GITHUB_WEBHOOK_SECRET=
# Test mode only: serve GitHub API responses recorded in backend/tests/fixtures/github instead of calling GitHub.
# The end-to-end suite turns this on so it never depends on a real person's gist. Startup refuses it when
# APP_ENV is staging or production.
GITHUB_FIXTURE_TRANSPORT=false

# --- Compliance: data export, account deletion and sanctions screening -------
# How long a generated data export stays downloadable before its archive is deleted.
DATA_EXPORT_TTL_HOURS=168
# Grace period between requesting account deletion and it being carried out; the user can cancel until then.
ACCOUNT_DELETION_GRACE_DAYS=14
# Screening of wallet addresses at wallet verification, before funding and before every payout.
# Leave on: turning it off is refused on mainnet.
SANCTIONS_SCREENING_ENABLED=true
# A list of Stellar addresses to block: a file path (relative to the repository root) or an https URL.
# Recognised formats: the OFAC SDN export ("Digital Currency Address - XLM ..." remarks), a JSON array, or one
# address per line with # comments. Admins can also add addresses by hand in the admin console.
# Both are empty by default, so only the manual list applies.
SANCTIONS_LIST_PATH=
SANCTIONS_LIST_URL=
SANCTIONS_LIST_NAME=Sanctions list
SANCTIONS_LIST_REFRESH_SECONDS=21600

# --- Operations: metrics endpoint --------------------------------------------
METRICS_ENABLED=true
# Bearer token for GET /metrics (Prometheus). While empty, /metrics answers only direct loopback requests and
# 404s everything else. Required on mainnet.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=

# --- Mainnet guard -----------------------------------------------------------
# STELLAR_NETWORK=mainnet refuses to start unless this is true AND every other requirement is met; the startup
# error lists them all. See docs/runbooks/mainnet-launch-checklist.md.
ALLOW_MAINNET=false
# Contracts that passed an independent audit, per network. A contract id must be listed here with its audit
# report before it can be used on mainnet.
AUDITED_DEPLOYMENTS_FILE=deploy/audited-deployments.json
# The API's own public https:// URL (e.g. https://api.bountyflow.example). Required on mainnet.
PUBLIC_API_URL=

# --- Frontend ----------------------------------------------------------------
# This is the only section the browser ever sees. Vite inlines every VITE_ variable into the
# JavaScript bundle at build time, so each one is public forever: never put a secret here. Nothing
# else in this file reaches the browser — Vite is configured to read the VITE_ prefix alone.

# Base URL of the versioned REST API as the browser sees it. The default is same-origin, proxied by
# Vite in development and by nginx in Docker. In Docker it is baked in at image build time
# (frontend/Dockerfile ARG), so changing it here needs a rebuild.
VITE_API_BASE_URL=/api/v1

# Development server only: where Vite proxies /api and /health. Never bundled.
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional public source repository URL (https only), shown in the footer.
VITE_GITHUB_URL=

# End-to-end tests only. Enables the Playwright-injected wallet so tests can sign real Testnet
# transactions without the Freighter extension. A production `vite build` refuses to run with it set.
# VITE_ENABLE_TEST_WALLET=true
